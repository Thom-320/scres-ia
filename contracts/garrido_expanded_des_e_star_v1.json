  "purpose": "Design the single thesis-grounded expanded DES kernel requested by Garrido before any new scientific execution.",
  "research_question": "Which physically valid expanded decision-right families create deployable contingent resilience value, how much is captured by structured control, and does any observable residual remain for a learned controller?",
  "scope": {
    "historical_reference": "E_Garrido",
    "prospective_kernel": "E_star",
    "attribution": "thesis-grounded reconstruction; not a validated digital twin",
    "program_q_is_a0": false,
    "program_o_is_a0": false,
    "required_physics": [
      "approved upstream supplier/procurement nodes",
      "approved downstream buffers and dispatch points",
      "finite buffers and capacities",
      "routes, transport capacity, and lead times",
      "inventory in transit",
      "production and replenishment conservation",
      "resource and service ledgers",
      "fixed exogenous demand and risk tapes",
      "native review cadences"
    ],
    "forbidden_shortcuts": [
      "strategic inventory or rations injected without an external source",
      "action creating inventory without upstream production/procurement and capacity",
      "future risk, future demand, or future outcome in the observation",
      "new nodes, transitions, risks, costs, or observation fields after kernel freeze",
      "post-hoc physics changes after a structural result"
    ]
  },
  "decision_families": {
    "P": "procurement authority for approved upstream sources",
    "U": "upstream-buffer authority",
    "D": "downstream-buffer and dispatch authority"
  },
  "factorial_masks": [
    {"mask_id": "M000", "P": false, "U": false, "D": false},
    {"mask_id": "M100", "P": true, "U": false, "D": false},
    {"mask_id": "M010", "P": false, "U": true, "D": false},
    {"mask_id": "M001", "P": false, "U": false, "D": true},
    {"mask_id": "M110", "P": true, "U": true, "D": false},
    {"mask_id": "M101", "P": true, "U": false, "D": true},
    {"mask_id": "M011", "P": false, "U": true, "D": true},
    {"mask_id": "M111", "P": true, "U": true, "D": true}
  ],
  "factorial_invariants": [
    "same frozen kernel hash",
    "same observation schema",
    "same exogenous demand and risk tapes",
    "same horizon and native cadences",
    "same resource budgets",
    "same metric hierarchy",
    "same SESOI and guardrail margins",
    "same search budget",
    "lower-mask incumbent embedded in every superset mask"
