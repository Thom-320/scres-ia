{
  "schema_version": "garrido_expanded_des_e_star_v1",
  "contract_id": "garrido_expanded_des_e_star_v1",
  "status": "DESIGN_ONLY_NOT_AUTHORIZED_UNTIL_SUBMISSION_A_RECEIPT",
  "authority": {
    "source": "main:contracts/authority_ladder_v1.json",
